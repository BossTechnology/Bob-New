# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Reference material downloaded from Drive (bulky zips + duplicates).
# The authoritative change spec is kept under Documentation/New/*.docx
Documentation/*
!Documentation/New/
Documentation/New/*
!Documentation/New/*.docx

# Supabase CLI local stack state
supabase/.branches/
supabase/.temp/

# contract-amendments.md is the handover artifact between build sessions: it
# carries every finding, amendment and its reasoning. It has to be tracked, or
# a new session is told to read a file that is not in the repository.
!Documentation/contract-amendments.md
